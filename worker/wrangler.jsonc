{
  // Cloudflare Worker that relays "Ask Jake" chat questions to Claude.
  // The Anthropic API key is stored as the secret ANTHROPIC_API_KEY in the
  // Cloudflare dashboard (Settings > Variables and Secrets), never in this repo.
  "name": "wine-library-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Swap to "claude-opus-5" for sharper pairing judgment (about 2.5x the cost).
    "MODEL": "claude-sonnet-5",
    "WINES_URL": "https://jakeworcester-byte.github.io/wine-library/wines.json",
    "PALATE_URL": "https://jakeworcester-byte.github.io/wine-library/palate.json",
    "ALLOWED_ORIGINS": "https://jakeworcester-byte.github.io,http://localhost:8763"
  },
  "ratelimits": [
    // Per visitor (by IP): 4 questions per minute.
    { "name": "PER_VISITOR", "namespace_id": "7101", "simple": { "limit": 4, "period": 60 } },
    // Whole site: 30 questions per minute, a brake on anything automated.
    { "name": "SITE_WIDE", "namespace_id": "7102", "simple": { "limit": 30, "period": 60 } }
  ],
  // Anonymous question log: question, answer, date, token counts. No IPs or
  // identities. Schema in schema.sql; rows older than 180 days are pruned by
  // the weekly sync (tools/REFRESH.md).
  "d1_databases": [
    { "binding": "LOG", "database_name": "wine-chat-log", "database_id": "921de635-8434-422d-b56f-d3ab1971b8a9" }
  ],
  "observability": { "enabled": true }
}
